{
  "name": "bookstore-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for bookstore application with user authentication, book management, and cart functionality",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=24.7.0 <25"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node scripts/seed.js",
    "e2e:server": "node scripts/e2e-server.js"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.2.6",
      "preferGlobalPath": true
    }
  },
  "keywords": [
    "bookstore",
    "api",
    "express",
    "mongodb",
    "jwt",
    "clean-mvc",
    "rest-api"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "8.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0",
    "nodemon": "^3.1.9",
    "supertest": "7.3.0",
    "vitest": "4.1.11"
  }
}
