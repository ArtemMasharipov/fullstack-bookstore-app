{
  "name": "bookstore-backend",
  "version": "1.0.0",
  "description": "Backend API for bookstore application with user authentication, book management, and cart functionality",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:kill": "taskkill /F /IM node.exe 2>nul & npm run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node scripts/seed.js"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.2.6",
      "preferGlobalPath": true
    }
  },
  "keywords": [
    "bookstore",
    "api",
    "express",
    "mongodb",
    "jwt",
    "clean-mvc",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0",
    "nodemon": "^3.1.9",
    "supertest": "7.3.0",
    "vitest": "4.1.11"
  }
}
