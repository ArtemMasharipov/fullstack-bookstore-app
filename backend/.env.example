# Copy to backend/.env and edit. Read by `npm start`, `npm run dev` and `npm run seed`
# (never when NODE_ENV=test). An empty value counts as not set.

# development | test | production
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/bookstore

# Required in every environment (at least 32 characters in production). Left empty, the backend
# does not start. Generate one and paste it after the = sign:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRATION=7d

# Required in production and must not be * there. Outside production it defaults to this value.
CORS_ORIGIN=http://localhost:8080
# CORS_METHODS=GET,POST,PUT,PATCH,DELETE
# CORS_CREDENTIALS=false

# Send error messages and stack traces to API clients. Ignored in production.
EXPOSE_ERROR_DETAILS=false

# npm run seed: passwords of admin@bookstore.local and reader@bookstore.local.
# Left empty, they are generated and printed once, but only in an interactive terminal.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
# SEED_ALLOW_REMOTE is never read from this file: do not set it here. To seed a database that is
# not local, pass it on the command line for that one run (it never works with --reset):
#   SEED_ALLOW_REMOTE=true npm run seed
